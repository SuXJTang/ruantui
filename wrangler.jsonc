{
  // ============================================================
  // 静态资源 = 仓库根目录，所以「不公开的东西」必须显式排除。
  // 排除走 `<assets 目录>/.assetsignore`（gitignore 语法），不是 assets 里的
  // 配置字段：Wrangler 的 assets 只接受 directory / binding / html_handling /
  // not_found_handling / base_path / run_worker_first，任何其它键只会被
  // 记为 "Unexpected fields found" 警告然后照常部署 —— 也就是静默失效。
  // 仓库根的 .assetsignore 承载这份排除清单（当前 8 条）：
  //   .*               根目录隐藏文件/目录（.git .wrangler .dev.vars* .env* .codegraph
  //                    .reasonix .tmp-test .check-*.js .verify*.js .dbg-*.js
  //                    .gitignore .dev.vars.example）
  //   *.md             README.md CHANGELOG.md
  //   migration.sql    完整库结构 + RLS 策略
  //   wrangler.jsonc   部署配置
  //   worker           本 Worker 源码
  //   .verify.js / .verify2.js / .check-*.js   脚手架脚本的显式兜底
  // 注意：gitignore 语法里 `*` 不匹配 dotfile，若缺了 `.*`，.dev.vars 这类
  // 文件会被原样上传成公开资源；而 img/ 是站点真实资源（头像、收款码，
  // index.html:116/263/264 引用），千万别忽略 img/。
  // 改动任何一个 *.js / *.html 资源时都要回来确认它仍被部署。
  // ============================================================
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ruantui",
  // 账户 ID 显式写入：CI（GitHub Actions）环境下若只靠环境变量，
  // wrangler 可能因读不到而报 "Could not determine account" 之类错误。
  // 这不是密钥，公开无风险（只是账户标识）。
  "account_id": "5214a85c8bde6fb1c09e690acb08c26d",
  "main": "worker/index.js",
  "compatibility_date": "2026-05-28",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    // 让所有请求都先经过 Worker，再由 Worker 内部调 env.ASSETS.fetch 取资源。
    // 原因：`run_worker_first: false`（默认）时，能匹配到静态资源的请求会被
    // Cloudflare 直接返回，**根本不进 Worker**，于是 Worker 里加的
    // Cache-Control 等响应头全部无效（实测线上仍是 max-age=0）。
    // 要让静态资源带上长缓存 / 安全头，必须走这个路径。
    //
    // 代价：每个请求都多进一次 Worker。但静态资源仍在同一个边缘节点内部读取，
    // 实测 TTFB 无明显回退，换来的是可控制的缓存策略与安全头，值得。
    "run_worker_first": true
  },
  "compatibility_flags": [
    "nodejs_compat"
  ],
  // 主站域名。写上后部署会自动维护这条 Custom Domain 绑定，
  // 不必再依赖在 Dashboard 手工配置（否则 CI 部署可能因「无目标」而报错）。
  "routes": [
    {
      "pattern": "luoluo.fun",
      "custom_domain": true
    }
  ],
  "workers_dev": false,
  "preview_urls": false
}
